# ─── โหมด CSV (ง่ายที่สุด ต้องเปิดชีตให้อ่านได้แบบสาธารณะ) ─────────────────
# แท็บที่มีข้อมูลจริง พร้อมแถวหัวข้อกลุ่ม "สถานะ : ..."
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/13SMQTIlSw2BHjy0LcTX_S0qiz6CGDNDx_8rsqAAeQj8/export?format=csv&gid=2144337691

# แท็บ "อาจารย์ที่ปรึกษา" ใช้เติมชื่ออาจารย์ (ไม่บังคับ ลบทิ้งได้)
SHEET_ADVISOR_CSV_URL=https://docs.google.com/spreadsheets/d/13SMQTIlSw2BHjy0LcTX_S0qiz6CGDNDx_8rsqAAeQj8/export?format=csv&gid=882980091

# ─── โหมด Apps Script (ชีตยังเป็นส่วนตัวได้ ใช้เมื่อไม่ตั้ง SHEET_CSV_URL) ──
# APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxx/exec
# APPS_SCRIPT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ─── ทั่วไป ────────────────────────────────────────────────────────────────
# true = แสดง GPA, เบอร์โทร และลิงก์เอกสารส่วนบุคคลด้วย
# ค่าเริ่มต้นคือ false เพราะใครก็ตามที่รู้รหัสนักศึกษาจะเห็นข้อมูลเหล่านี้ได้ทันที
SHOW_SENSITIVE_FIELDS=false

# เก็บข้อมูลไว้ในหน่วยความจำกี่วินาทีก่อนโหลดชีตใหม่
SHEET_CACHE_SECONDS=120
