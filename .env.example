# URL ของ Google Apps Script Web App (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxx/exec

# ต้องตรงกับ CONFIG.API_TOKEN ใน apps-script/Code.gs
APPS_SCRIPT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# true = แสดง GPA, เบอร์โทร และลิงก์เอกสารส่วนบุคคลด้วย
# ค่าเริ่มต้นคือ false เพราะใครก็ตามที่รู้รหัสนักศึกษาจะเห็นข้อมูลเหล่านี้ได้ทันที
SHOW_SENSITIVE_FIELDS=false
